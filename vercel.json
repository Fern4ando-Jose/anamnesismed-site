{
  "rewrites": [
    { "source": "/", "destination": "/anamnesismed-landing.html" },
    { "source": "/app", "destination": "/anamnesismed-app.html" },
    { "source": "/dashboard", "destination": "/anamnesismed-dashboard.html" },
    { "source": "/login", "destination": "/anamnesismed-auth.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://zrntgfsciiwhwghadosg.supabase.co; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/gerar-hc.js": {
      "maxDuration": 30
    },
    "api/assistente-dx.js": {
      "maxDuration": 60
    },
    "api/create-checkout-session.js": {
      "maxDuration": 15
    },
    "api/manter-banco-vivo.js": {
      "maxDuration": 15
    },
    "api/excluir-conta.js": {
      "maxDuration": 30
    },
    "api/exportar-dados.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/manter-banco-vivo", "schedule": "0 9 * * *" }
  ]
}
