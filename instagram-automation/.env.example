# ── Meta / Instagram ──────────────────────────────────────────────────────────
META_ACCESS_TOKEN=         # Token de longa duração (60 dias) da Meta
META_INSTAGRAM_ACCOUNT_ID= # ID numérico da conta @anamnesismed
META_APP_ID=               # App ID do seu Meta App
META_APP_SECRET=           # App Secret do seu Meta App

# ── Anthropic (Claude) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=         # sua chave da API do Claude

# ── fal.ai (ilustração de capa por IA) ─────────────────────────────────────────
FAL_KEY=                   # chave da fal (formato xxxx:yyyy). Sem ela, a capa cai no fundo escuro
FAL_MODEL=fal-ai/flux/dev  # opcional: fal-ai/flux/schnell p/ ~8x mais barato/rápido

# ── Idioma / conta ─────────────────────────────────────────────────────────────
POST_LANG=pt               # pt p/ @anamnesismed | es p/ @anamnesismed.es
POST_HANDLE=               # opcional: @ exibido no CTA/rodapé (default segue POST_LANG)

# ── Tavily (pesquisa de contexto) ─────────────────────────────────────────────
TAVILY_API_KEY=            # chave Tavily para busca de contexto médico

# ── Vercel Postgres ────────────────────────────────────────────────────────────
POSTGRES_URL=              # preenchido automaticamente pelo Vercel
POSTGRES_URL_NON_POOLING=  # preenchido automaticamente pelo Vercel

# ── App ────────────────────────────────────────────────────────────────────────
PRODUCTION_URL=https://anamnesismed-ig.vercel.app  # URL do deploy desta automação
CRON_SECRET=               # string aleatória longa para autenticar crons
